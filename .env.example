# Supabase
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=tu-llave-anonima-local

# Solo para docker-compose (alternativa a la CLI)
POSTGRES_PASSWORD=cambia-esta-clave
JWT_SECRET=un-secreto-de-al-menos-32-caracteres-de-largo

# Solo desarrollo local - nunca subir valores reales

# Minutos de inactividad tras los que la sesion se cierra sola (480 = 8 horas).
# El servidor aplica su propio limite: GOTRUE_SESSIONS_INACTIVITY_TIMEOUT
# (docker-compose.yml) / [auth.sessions] inactivity_timeout (config.toml).
VITE_SESION_INACTIVIDAD_MINUTOS=480

# OJO: toda variable VITE_* queda incrustada en el JavaScript que recibe el
# navegador. Nunca pongas aqui contrasenas ni la llave service_role.
